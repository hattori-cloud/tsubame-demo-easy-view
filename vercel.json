{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {"src": "api/router.js", "use": "@vercel/node"},
    {"src": "index.html", "use": "@vercel/static"}
  ],
  "routes": [
    {"src": "/api/v1(?:/(.*))?", "dest": "/api/router.js?__path=$1"},
    {"src": "/(.*)", "dest": "/index.html"}
  ]
}
